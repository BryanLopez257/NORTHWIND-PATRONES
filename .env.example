# ========================================================
# ARCHIVO DE EJEMPLO DE VARIABLES DE ENTORNO (.env.example)
# Copia este archivo como .env y coloca tus credenciales reales
# ========================================================

# Cadenas de conexion a Bases de Datos (SQL Server)
DBOptions__ConnectionString="Server=127.0.0.1,1433;Database=NorthWindDB;User Id=sa;Password=YourPasswordHere!;TrustServerCertificate=True;Encrypt=True;"
DBOptions__DomainLogsConnectionString="Server=127.0.0.1,1433;Database=NorthWindLogsDB;User Id=sa;Password=YourPasswordHere!;TrustServerCertificate=True;Encrypt=True;Enlist=false;"
MembershipDBOptions__ConnectionString="Server=127.0.0.1,1433;Database=NorthWindUsersDB;User Id=sa;Password=YourPasswordHere!;TrustServerCertificate=True;Encrypt=True;"
MembershipDB__ConnectionString="Server=127.0.0.1,1433;Database=NorthWindUsersDB;User Id=sa;Password=YourPasswordHere!;TrustServerCertificate=True;Encrypt=True;"

# JWT Autenticacion
JwtOptions__SecurityKey="KeyMustBeAtLeast32CharactersLongAndSecure12345!"
JwtOptions__ValidIssuer="NorthWindSales"
JwtOptions__ValidAudience="NorthWindSalesClient"
JwtOptions__ExpireInMinutes=1440
JwtOptions__ValidateIssuer=true
JwtOptions__ValidateAudience=true
JwtOptions__ValidateLifetime=true
JwtOptions__ValidateIssuerSigningKey=true

# JWT Parametros (Alias)
Jwt__SecretKey="KeyMustBeAtLeast32CharactersLongAndSecure12345!"
Jwt__Issuer="NorthWindSales"
Jwt__Audience="NorthWindSalesClient"
Jwt__ExpirationMinutes=1440

# Configuracion de Servidor de Correo (SMTP)
SmtpOptions__SmtpHost="sandbox.smtp.mailtrap.io"
SmtpOptions__SmtpHostPort=2525
SmtpOptions__SmtpUserName="your_mailtrap_user"
SmtpOptions__SmtpPassword="your_mailtrap_password"
SmtpOptions__SenderEmail="orders@northwind.com"
SmtpOptions__AdministratorEmail="admin@northwind.com"

# SMTP Alias
Smtp__Host="sandbox.smtp.mailtrap.io"
Smtp__Port=2525
Smtp__From="orders@northwind.com"
Smtp__AdministratorEmail="admin@northwind.com"
Smtp__UserName="your_mailtrap_user"
Smtp__Password="your_mailtrap_password"
Smtp__EnableSsl=true
