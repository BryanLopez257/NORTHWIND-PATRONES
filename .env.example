# ========================================================
# ARCHIVO DE EJEMPLO DE VARIABLES DE ENTORNO (.env.example)
# Copia este archivo como .env y coloca tus credenciales reales
# ========================================================

# Cadenas de conexión a Bases de Datos (SQL Server)
DBOptions__ConnectionString="Server=localhost,1433;Database=NorthWindDB;User Id=sa;Password=YourPasswordHere!;TrustServerCertificate=True;"
DBOptions__DomainLogsConnectionString="Server=localhost,1433;Database=NorthWindLogsDB;User Id=sa;Password=YourPasswordHere!;TrustServerCertificate=True;"
MembershipDBOptions__ConnectionString="Server=localhost,1433;Database=NorthWindUsersDB;User Id=sa;Password=YourPasswordHere!;TrustServerCertificate=True;"
MembershipDB__ConnectionString="Server=localhost,1433;Database=NorthWindUsersDB;User Id=sa;Password=YourPasswordHere!;TrustServerCertificate=True;"

# JWT Autenticación
JwtOptions__SecurityKey="Your32CharacterLongSecretSecurityKeyHere!!"
JwtOptions__ValidIssuer="NorthWindAuthServer"
JwtOptions__ValidAudience="NorthWindClient"
JwtOptions__ExpireInMinutes=60
JwtOptions__ValidateIssuer=true
JwtOptions__ValidateAudience=true
JwtOptions__ValidateLifetime=true
JwtOptions__ValidateIssuerSigningKey=true

# JWT Parámetros (Alias)
Jwt__SecretKey="Your32CharacterLongSecretSecurityKeyHere!!"
Jwt__Issuer="NorthWindAuthServer"
Jwt__Audience="NorthWindClient"
Jwt__ExpirationMinutes=60

# Configuración de Servidor de Correo (SMTP)
SmtpOptions__SmtpHost="sandbox.smtp.mailtrap.io"
SmtpOptions__SmtpHostPort=2525
SmtpOptions__SmtpUserName="your_mailtrap_user"
SmtpOptions__SmtpPassword="your_mailtrap_password"
SmtpOptions__SenderEmail="noreply@northwind.com"
SmtpOptions__AdministratorEmail="admin@northwind.com"

# SMTP Alias
Smtp__Host="sandbox.smtp.mailtrap.io"
Smtp__Port=2525
Smtp__From="noreply@northwind.com"
Smtp__AdministratorEmail="admin@northwind.com"
Smtp__UserName="your_mailtrap_user"
Smtp__Password="your_mailtrap_password"
Smtp__EnableSsl=true
