@namespace NorthWind.Sales.Frontend.Views.Components

<div class="order-container">
    <div class="order-header-card">
        <h1 class="order-header-title">
            <i class="bi bi-cart-check text-primary-light"></i>
            @CreateOrderMessages.CreateOrderPageTitle
        </h1>
        <p class="order-header-desc">
            Registra una nueva orden de venta para un cliente. Las órdenes con más de 3 productos serán tratadas como órdenes especiales y notificarán al administrador mediante Mailtrap.
        </p>
    </div>

    @if (!string.IsNullOrEmpty(Order.InformationMessage))
    {
        <div class="alert alert-success d-flex align-items-center justify-content-between flex-wrap gap-2 mb-4 p-3 shadow-sm rounded-3">
            <div class="d-flex align-items-center gap-3">
                <i class="bi bi-check-circle-fill fs-3 text-success"></i>
                <div>
                    <strong class="fs-6">¡Orden y Factura Generadas con Éxito!</strong><br />
                    <span>@Order.InformationMessage</span>
                </div>
            </div>
            @if (Order.GeneratedInvoice != null)
            {
                <div class="d-flex gap-2">
                    <button type="button" class="btn btn-primary btn-sm d-flex align-items-center gap-1 shadow-sm"
                            @onclick="() => ViewInvoiceVoucher(Order.GeneratedInvoice)">
                        <i class="bi bi-receipt"></i>
                        <span>Ver Factura (@Order.GeneratedInvoice.InvoiceNumber)</span>
                    </button>
                    <a href="/invoices" class="btn btn-outline-primary btn-sm d-flex align-items-center gap-1">
                        <i class="bi bi-journal-text"></i>
                        <span>Historial Facturas</span>
                    </a>
                </div>
            }
        </div>
    }

    @if (!string.IsNullOrEmpty(Order.ErrorMessage))
    {
        <div class="alert alert-danger d-flex align-items-center gap-2 mb-4">
            <i class="bi bi-exclamation-triangle-fill fs-4"></i>
            <div>
                <strong>Error en el Servidor</strong><br />
                @Order.ErrorMessage
            </div>
        </div>
    }

    <EditForm Model="Order" OnValidSubmit="HandleValidSubmit">
        <ModelValidator Validator="Order.Validator" @ref="Order.ModelValidatorComponentReference" />
        <ValidationSummary />

        <!-- Sección 1: Datos de Entrega y Cliente -->
        <div class="order-section-card">
            <div class="order-section-title">
                <i class="bi bi-person-vcard text-primary"></i>
                1. Información del Cliente y Envío
            </div>

            <div class="row g-3">
                <div class="col-md-6">
                    <label for="customerId">
                        <i class="bi bi-person-badge"></i>
                        @CreateOrderMessages.CustomerIdLabel
                    </label>
                    <div class="input-group">
                        <input type="text" class="form-control font-monospace text-uppercase" id="customerId" placeholder="Ej: ALFKI (5 letras)" maxlength="5"
                               data-alpha-only="true"
                               onkeypress="return /^[a-zA-Z]$/.test(event.key)"
                               value="@Order.CustomerId"
                               @oninput="HandleCustomerIdInput" />
                        <button type="button" class="btn btn-primary" @onclick="OpenCustomerPicker" title="Seleccionar cliente del catálogo">
                            <i class="bi bi-people-fill me-1"></i> Buscar Cliente
                        </button>
                    </div>
                    @if (!string.IsNullOrEmpty(CustomerSelectedError))
                    {
                        <div class="alert alert-danger p-2 mt-2 mb-0 small d-flex align-items-center gap-2 rounded-3 shadow-sm">
                            <i class="bi bi-exclamation-octagon-fill text-danger fs-5"></i>
                            <div>@CustomerSelectedError</div>
                        </div>
                    }
                    else if (!string.IsNullOrEmpty(CustomerNameSelected))
                    {
                        <div class="d-flex align-items-center gap-2 mt-2 flex-wrap">
                            <div class="small text-success fw-semibold">
                                <i class="bi bi-check-circle-fill me-1"></i> Cliente Habilitado: <span>@CustomerNameSelected</span>
                            </div>
                            @if (CustomerTypeSelected == "Persona Natural")
                            {
                                <span class="badge bg-info-subtle text-info-emphasis border border-info-subtle">
                                    <i class="bi bi-person-fill me-1"></i> Persona Natural
                                </span>
                            }
                            else if (CustomerTypeSelected == "Empresa")
                            {
                                <span class="badge bg-primary-subtle text-primary border border-primary-subtle">
                                    <i class="bi bi-building me-1"></i> Empresa
                                </span>
                            }
                        </div>
                    }
                    <ValidationMessage For="() => Order.CustomerId" />
                </div>

                <div class="col-md-6">
                    <label for="customerDocument">
                        <i class="bi bi-card-text"></i>
                        @CreateOrderMessages.CustomerDocumentLabel
                    </label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-hash"></i></span>
                        <input type="text" class="form-control font-monospace" id="customerDocument"
                               placeholder="10 dígitos (Cédula) o 13 dígitos (RUC)" maxlength="13"
                               inputmode="numeric"
                               data-numeric-only="true"
                               onkeypress="return /^[0-9]$/.test(event.key)"
                               value="@Order.CustomerDocument"
                               @oninput="HandleCustomerDocumentInput" />
                    </div>
                    <div class="d-flex justify-content-between align-items-center mt-1">
                        @if (!string.IsNullOrEmpty(Order.CustomerDocument))
                        {
                            @if (Order.CustomerDocument.Length == 10)
                            {
                                @if (IsValidEcuadorianCedula(Order.CustomerDocument))
                                {
                                    <span class="badge bg-success-subtle text-success border border-success-subtle small">
                                        <i class="bi bi-check-circle-fill me-1"></i> Cédula Ecuatoriana Válida
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle small">
                                        <i class="bi bi-x-circle-fill me-1"></i> Cédula Inválida (no cumple Módulo 10)
                                    </span>
                                }
                            }
                            else if (Order.CustomerDocument.Length == 13)
                            {
                                @if (IsValidEcuadorianRuc(Order.CustomerDocument))
                                {
                                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle small">
                                        <i class="bi bi-check-circle-fill me-1"></i> RUC Ecuatoriano Válido
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle small">
                                        <i class="bi bi-x-circle-fill me-1"></i> RUC Inválido
                                    </span>
                                }
                            }
                            else
                            {
                                <span class="badge bg-secondary-subtle text-secondary small">
                                    @Order.CustomerDocument.Length / 10 (Cédula) o 13 (RUC)
                                </span>
                            }
                        }
                    </div>
                    @if (!string.IsNullOrEmpty(CustomerTypeSelected))
                    {
                        <div class="small text-muted mt-1">
                            @if (CustomerTypeSelected == "Persona Natural")
                            {
                                <span><i class="bi bi-info-circle text-info me-1"></i> <strong>Persona Natural:</strong> Cédula de 10 dígitos (o RUC de 13 dígitos).</span>
                            }
                            else
                            {
                                <span><i class="bi bi-info-circle text-primary me-1"></i> <strong>Empresa:</strong> RUC de 13 dígitos terminado en 001.</span>
                            }
                        </div>
                    }
                    <ValidationMessage For="() => Order.CustomerDocument" />
                </div>

                <div class="col-md-12">
                    <label for="shipAddress">
                        <i class="bi bi-signpost-2"></i>
                        @CreateOrderMessages.ShipAddressLabel
                    </label>
                    <InputText class="form-control" id="shipAddress" placeholder="Dirección completa (máx. 60 caracteres)" maxlength="60"
                               onkeypress="return /^[a-zA-Z0-9áéíóúÁÉÍÓÚñÑüÜ\s\.,#\-\/°]$/.test(event.key)"
                               @bind-Value="Order.ShipAddress" />
                    <div class="d-flex justify-content-between align-items-center mt-1">
                        <span class="text-muted small">Sin caracteres especiales no permitidos (solo letras, números y signos: . , - # / °)</span>
                        @if (!string.IsNullOrEmpty(Order.ShipAddress))
                        {
                            <span class="badge bg-secondary-subtle text-secondary small">@Order.ShipAddress.Length / 60</span>
                        }
                    </div>
                    <ValidationMessage For="() => Order.ShipAddress" />
                </div>

                <div class="col-md-4">
                    <label for="shipCity">
                        <i class="bi bi-building"></i>
                        @CreateOrderMessages.ShipCityLabel
                    </label>
                    <InputText class="form-control" id="shipCity" placeholder="Ciudad (máx. 15 letras)" maxlength="15"
                               data-letters-only="true"
                               onkeypress="return /^[a-zA-ZáéíóúÁÉÍÓÚñÑüÜ\s]$/.test(event.key)"
                               @bind-Value="Order.ShipCity" />
                    <div class="d-flex justify-content-between align-items-center mt-1">
                        <span class="text-muted small">3 a 15 letras (sin números)</span>
                        @if (!string.IsNullOrEmpty(Order.ShipCity))
                        {
                            <span class="badge @(Order.ShipCity.Length >= 3 ? "bg-success-subtle text-success" : "bg-warning-subtle text-warning") small">
                                @Order.ShipCity.Length / 15
                            </span>
                        }
                    </div>
                    <ValidationMessage For="() => Order.ShipCity" />
                </div>

                <div class="col-md-4">
                    <label for="shipCountry">
                        <i class="bi bi-globe-americas"></i>
                        @CreateOrderMessages.ShipCountryLabel
                    </label>
                    <InputText class="form-control" id="shipCountry" placeholder="País (máx. 15 letras)" maxlength="15"
                               data-letters-only="true"
                               onkeypress="return /^[a-zA-ZáéíóúÁÉÍÓÚñÑüÜ\s]$/.test(event.key)"
                               @bind-Value="Order.ShipCountry" />
                    <div class="d-flex justify-content-between align-items-center mt-1">
                        <span class="text-muted small">3 a 15 letras (sin números)</span>
                        @if (!string.IsNullOrEmpty(Order.ShipCountry))
                        {
                            <span class="badge @(Order.ShipCountry.Length >= 3 ? "bg-success-subtle text-success" : "bg-warning-subtle text-warning") small">
                                @Order.ShipCountry.Length / 15
                            </span>
                        }
                    </div>
                    <ValidationMessage For="() => Order.ShipCountry" />
                </div>

                <div class="col-md-4">
                    <label for="shipPostalCode">
                        <i class="bi bi-mailbox"></i>
                        @CreateOrderMessages.ShipPostalCodeLabel
                    </label>
                    <InputText class="form-control font-monospace" id="shipPostalCode" placeholder="Código Postal (máx. 10)" maxlength="10" @bind-Value="Order.ShipPostalCode" />
                    <div class="d-flex justify-content-between align-items-center mt-1">
                        <span class="text-muted small">Máx. 10 caracteres</span>
                        @if (!string.IsNullOrEmpty(Order.ShipPostalCode))
                        {
                            <span class="badge bg-secondary-subtle text-secondary small">@Order.ShipPostalCode.Length / 10</span>
                        }
                    </div>
                    <ValidationMessage For="() => Order.ShipPostalCode" />
                </div>
            </div>
        </div>

        <!-- Sección 2: Productos del Pedido -->
        <div class="order-section-card">
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3 pb-2 border-bottom">
                <div class="order-section-title mb-0 border-0 pb-0">
                    <i class="bi bi-boxes text-primary"></i>
                    2. Líneas de Productos
                </div>
                <div>
                    @if (Order.OrderDetails.Count > 3)
                    {
                        <span class="special-order-badge">
                            <i class="bi bi-envelope-check-fill"></i>
                            Orden Especial (&gt; 3 productos) 👉 Se notificará vía Mailtrap
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-light text-secondary border">
                            @Order.OrderDetails.Count producto(s) añadido(s)
                        </span>
                    }
                </div>
            </div>

            @if (Order.OrderDetails == null || Order.OrderDetails.Count == 0)
            {
                <div class="text-center py-4 text-muted bg-light rounded-3 mb-3 border border-dashed">
                    <i class="bi bi-inbox fs-2 d-block mb-1 text-secondary"></i>
                    No hay productos agregados a la orden aún.
                </div>
            }
            else
            {
                <div class="d-none d-md-flex row g-2 px-3 py-2 text-muted fw-semibold small align-items-center">
                    <div class="col-md-1 text-center">#</div>
                    <div class="col-md-2">@CreateOrderMessages.ProductIdLabel</div>
                    <div class="col-md-3">@CreateOrderMessages.ProductDescriptionLabel</div>
                    <div class="col-md-1 text-center">Stock</div>
                    <div class="col-md-2 text-end">@CreateOrderMessages.UnitPriceLabel</div>
                    <div class="col-md-1 text-center">@CreateOrderMessages.QuantityLabel</div>
                    <div class="col-md-1 text-end">Subtotal</div>
                    <div class="col-md-1 text-center">@CreateOrderMessages.ActionsColumnLabel</div>
                </div>

                @for (int i = 0; i < Order.OrderDetails.Count; i++)
                {
                    var Item = Order.OrderDetails[i];
                    var itemNumber = i + 1;
                    <div class="product-row-item">
                        <div class="row g-2 align-items-center">
                            <div class="col-md-1 text-center fw-bold text-muted">
                                <span class="badge bg-secondary">@itemNumber</span>
                            </div>
                            <div class="col-md-2">
                                <div class="d-md-none text-muted small">@CreateOrderMessages.ProductIdLabel:</div>
                                <div class="input-group input-group-sm">
                                    <input type="text" class="form-control font-monospace bg-light text-center fw-bold" placeholder="ID"
                                           value="@(Item.ProductId == 0 ? "-" : Item.ProductId.ToString())"
                                           readonly tabindex="-1"
                                           style="cursor: not-allowed; background-color: #f1f3f5;"
                                           title="El ID no es editable directamente. Usa el botón Buscar para seleccionar un producto del catálogo." />
                                    <button type="button" class="btn btn-primary" title="Buscar producto del catálogo" @onclick="() => OpenProductPicker(Item)">
                                        <i class="bi bi-search"></i>
                                    </button>
                                </div>
                                @if (HasDuplicateProduct(Item))
                                {
                                    <div class="text-danger small mt-1 fw-bold">
                                        <i class="bi bi-exclamation-octagon-fill me-1"></i> Duplicado
                                    </div>
                                }
                                <ValidationMessage For="() => Item.ProductId" />
                            </div>
                            <div class="col-md-3">
                                <div class="d-md-none text-muted small">@CreateOrderMessages.ProductDescriptionLabel:</div>
                                @if (!string.IsNullOrEmpty(Item.ProductName))
                                {
                                    <div class="fw-semibold text-dark text-truncate d-flex align-items-center gap-1" title="@Item.ProductName">
                                        <i class="bi bi-box-seam text-primary"></i>
                                        <span>@Item.ProductName</span>
                                    </div>
                                }
                                else
                                {
                                    <div class="text-muted small fst-italic d-flex align-items-center gap-1">
                                        <i class="bi bi-question-circle"></i>
                                        <span>Sin seleccionar (usa Buscar)</span>
                                    </div>
                                }
                            </div>
                            <div class="col-md-1 text-center">
                                <div class="d-md-none text-muted small">Stock:</div>
                                @if (Item.ProductId > 0)
                                {
                                    <span class="badge @(Item.UnitsInStock <= 0 ? "bg-danger-subtle text-danger border border-danger-subtle" : Item.UnitsInStock <= 5 ? "bg-warning-subtle text-warning-emphasis border border-warning-subtle" : "bg-primary-subtle text-primary border border-primary-subtle") font-monospace" title="Stock disponible: @Item.UnitsInStock unidades">
                                        @Item.UnitsInStock uds
                                    </span>
                                }
                                else
                                {
                                    <span class="text-muted small">-</span>
                                }
                            </div>
                            <div class="col-md-2">
                                <div class="d-md-none text-muted small">@CreateOrderMessages.UnitPriceLabel:</div>
                                <div class="input-group input-group-sm">
                                    <span class="input-group-text bg-light text-secondary">$</span>
                                    <input type="text" class="form-control text-end font-monospace bg-light fw-semibold"
                                           value="@Item.UnitPrice.ToString("N2")"
                                           readonly tabindex="-1"
                                           style="cursor: not-allowed; background-color: #f1f3f5;"
                                           title="El precio unitario no es editable; se carga automáticamente desde el catálogo." />
                                </div>
                                <ValidationMessage For="() => Item.UnitPrice" />
                            </div>
                            <div class="col-md-1">
                                <div class="d-md-none text-muted small">@CreateOrderMessages.QuantityLabel:</div>
                                <InputNumber class="form-control form-control-sm text-center font-monospace" placeholder="Cant." @bind-Value="Item.Quantity" />
                                @if (Item.UnitsInStock > 0 && Item.Quantity > Item.UnitsInStock)
                                {
                                    <div class="text-danger small mt-1 fw-bold text-center" title="La cantidad (@Item.Quantity) supera el stock disponible (@Item.UnitsInStock)">
                                        <i class="bi bi-exclamation-triangle-fill"></i> Excede
                                    </div>
                                }
                                <ValidationMessage For="() => Item.Quantity" />
                            </div>
                            <div class="col-md-1 text-end fw-semibold text-primary font-monospace">
                                <div class="d-md-none text-muted small text-start">Subtotal:</div>
                                <span>$@((Item.UnitPrice * Item.Quantity).ToString("N2"))</span>
                            </div>
                            <div class="col-md-1 text-center">
                                <button type="button" class="btn btn-outline-danger btn-sm" title="@CreateOrderMessages.DeleteDetailButton" @onclick="() => RemoveOrderDetailItem(Item)">
                                    <i class="bi bi-trash3"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                }
            }

            <div class="mt-3 d-flex flex-wrap gap-2">
                <button type="button" class="btn btn-primary" @onclick="OpenProductPickerForNewItem">
                    <i class="bi bi-search me-1"></i>
                    Buscar Producto
                </button>
                <button type="button" class="btn btn-outline-secondary" @onclick="Order.AddNewOrderDetailItem">
                    <i class="bi bi-plus-circle me-1"></i>
                    @CreateOrderMessages.AddDetailButton
                </button>
            </div>
        </div>

        <!-- Sección 3: Resumen de Liquidación y Facturación -->
        <div class="order-section-card bg-white border shadow-sm">
            <div class="order-section-title d-flex justify-content-between align-items-center flex-wrap gap-2">
                <span class="d-flex align-items-center gap-2">
                    <i class="bi bi-receipt text-primary fs-5"></i>
                    3. Resumen de Liquidación de la Orden
                </span>
                <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-3 py-1">
                    <i class="bi bi-shield-check me-1"></i> Facturación Inmutable con IVA 15%
                </span>
            </div>

            <div class="row g-4 align-items-center">
                <!-- Columna Izquierda: Información de la Emisión -->
                <div class="col-lg-6">
                    <div class="p-3 bg-light rounded-3 border">
                        <div class="d-flex align-items-center gap-2 text-dark fw-bold mb-2">
                            <i class="bi bi-info-circle-fill text-primary"></i>
                            <span>Condiciones y Trazabilidad</span>
                        </div>
                        <ul class="list-unstyled mb-0 small text-muted">
                            <li class="mb-1 d-flex align-items-center gap-2">
                                <i class="bi bi-check2 text-success"></i>
                                <span><strong>Facturación Inmediata:</strong> Al confirmar la orden se emite la Factura Electrónica secuencial.</span>
                            </li>
                            <li class="mb-1 d-flex align-items-center gap-2">
                                <i class="bi bi-check2 text-success"></i>
                                <span><strong>Instantánea Histórica:</strong> Datos de cliente, vendedor y precios quedan congelados.</span>
                            </li>
                            <li class="d-flex align-items-center gap-2">
                                <i class="bi bi-check2 text-success"></i>
                                <span><strong>Inventario Automático:</strong> El stock de cada producto se descuenta de forma atómica.</span>
                            </li>
                        </ul>
                    </div>
                </div>

                <!-- Columna Derecha: Tabla Resumen de Liquidación -->
                <div class="col-lg-6">
                    <div class="p-3 bg-light rounded-3 border">
                        <table class="table table-sm table-borderless mb-0">
                            <tbody>
                                <tr>
                                    <td class="text-muted fw-semibold">Total de Unidades:</td>
                                    <td class="text-end fw-bold">@Order.TotalUnits uds</td>
                                </tr>
                                <tr>
                                    <td class="text-muted fw-semibold">Subtotal Base Imponible:</td>
                                    <td class="text-end font-monospace fw-bold fs-6">$@Order.SubTotal.ToString("N2")</td>
                                </tr>
                                <tr>
                                    <td class="text-muted fw-semibold">
                                        IVA (Tarifa 15%):
                                        <span class="badge bg-secondary-subtle text-secondary ms-1">Ecuador</span>
                                    </td>
                                    <td class="text-end font-monospace fw-bold text-secondary fs-6">$@Order.Tax.ToString("N2")</td>
                                </tr>
                                <tr class="border-top">
                                    <td class="fs-5 fw-bold text-dark pt-2">TOTAL A LIQUIDAR:</td>
                                    <td class="fs-4 fw-bold font-monospace text-primary text-end pt-2">
                                        $@Order.Total.ToString("N2")
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- Botón de Envío -->
            <div class="mt-4 pt-3 border-top d-flex justify-content-between align-items-center flex-wrap gap-3">
                <div class="text-muted small">
                    <i class="bi bi-check-circle text-primary me-1"></i>
                    Verifica que las líneas y el cliente sean correctos antes de confirmar la liquidación.
                </div>
                <button type="submit" class="btn btn-primary px-4 py-2 fs-6 shadow-sm d-flex align-items-center gap-2"
                        disabled="@(Order.OrderDetails.Count == 0)">
                    <i class="bi bi-send-check-fill fs-5"></i>
                    <span>@CreateOrderMessages.SendButton y Emitir Factura</span>
                </button>
            </div>
        </div>
    </EditForm>
</div>

<!-- Modal Selector de Clientes -->
@if (ShowCustomerPicker)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content shadow border-0 rounded-3">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title fw-bold d-flex align-items-center gap-2">
                        <i class="bi bi-people-fill"></i>
                        Seleccionar Cliente para la Orden
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="ClosePickers"></button>
                </div>
                <div class="modal-body p-4">
                    @if (!string.IsNullOrEmpty(CustomerPickerWarning))
                    {
                        <div class="alert alert-danger d-flex align-items-center gap-2 mb-3 shadow-sm rounded-3">
                            <i class="bi bi-exclamation-triangle-fill fs-5 text-danger"></i>
                            <div>@CustomerPickerWarning</div>
                        </div>
                    }

                    <div class="alert alert-info py-2 px-3 mb-3 small d-flex align-items-center gap-2 rounded-3 border-info-subtle">
                        <i class="bi bi-info-circle-fill text-primary fs-5"></i>
                        <div><strong>Condición de Crédito:</strong> Solo se permite crear órdenes a clientes con saldo <strong>$0.00</strong>. Clientes con saldo pendiente están bloqueados.</div>
                    </div>

                    <!-- Segmentación por Tipo de Cliente (Personas Naturales vs Empresas) -->
                    <div class="mb-3">
                        <div class="btn-group w-100 shadow-sm" role="group">
                            <button type="button" class="btn btn-sm py-2 @(string.IsNullOrEmpty(CustomerPickerCustomerType) ? "btn-primary text-white" : "btn-outline-secondary")"
                                    @onclick='() => SetCustomerPickerType("")'>
                                <i class="bi bi-people-fill me-1"></i> Todos (@AllCatalogCustomers.Count)
                            </button>
                            <button type="button" class="btn btn-sm py-2 @(CustomerPickerCustomerType == "Persona Natural" ? "btn-info text-white" : "btn-outline-info")"
                                    @onclick='() => SetCustomerPickerType("Persona Natural")'>
                                <i class="bi bi-person-badge-fill me-1"></i> Personas Naturales (@AllCatalogCustomers.Count(c => c.CustomerType == "Persona Natural"))
                            </button>
                            <button type="button" class="btn btn-sm py-2 @(CustomerPickerCustomerType == "Empresa" ? "btn-dark text-white" : "btn-outline-dark")"
                                    @onclick='() => SetCustomerPickerType("Empresa")'>
                                <i class="bi bi-building-fill me-1"></i> Empresas (@AllCatalogCustomers.Count(c => c.CustomerType == "Empresa"))
                            </button>
                        </div>
                    </div>

                    <div class="input-group mb-3 shadow-sm">
                        <span class="input-group-text bg-light text-secondary">
                            <i class="bi bi-funnel-fill me-1 text-primary"></i> Buscar por:
                        </span>
                        <select class="form-select flex-grow-0" style="width: 140px;"
                                value="@CustomerPickerSearchType" @onchange="OnCustomerPickerSearchTypeChanged">
                            <option value="all">🔍 Todos</option>
                            <option value="name">👤 Nombre</option>
                            <option value="code">🏷️ Código</option>
                        </select>
                        <input type="text" class="form-control" placeholder="@GetCustomerSearchPlaceholder()"
                               value="@CustomerPickerSearchTerm" @oninput="OnCustomerPickerInput" />
                        @if (!string.IsNullOrEmpty(CustomerPickerSearchTerm))
                        {
                            <button class="btn btn-outline-secondary" type="button" title="Limpiar búsqueda" @onclick="ClearCustomerPickerSearch">
                                <i class="bi bi-x-lg"></i>
                            </button>
                        }
                    </div>

                    <div class="table-responsive" style="max-height: 350px; overflow-y: auto;">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light sticky-top">
                                <tr>
                                    <th>Código</th>
                                    <th>Nombre del Cliente</th>
                                    <th class="text-center">Tipo</th>
                                    <th class="text-end">Saldo Actual</th>
                                    <th class="text-center">Estado / Acción</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (AvailableCustomers.Count == 0)
                                {
                                    <tr>
                                        <td colspan="5" class="text-center py-4 text-muted">
                                            No se encontraron clientes.
                                        </td>
                                    </tr>
                                }
                                else
                                {
                                    @foreach (var c in AvailableCustomers)
                                    {
                                        var hasDebt = c.CurrentBalance > 0;
                                        <tr class="@(hasDebt ? "table-danger bg-opacity-25" : "")">
                                            <td><span class="badge bg-secondary font-monospace">@c.Id</span></td>
                                            <td>
                                                <div class="fw-semibold">@c.Name</div>
                                                @if (hasDebt)
                                                {
                                                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle small mt-1">
                                                        <i class="bi bi-exclamation-octagon-fill me-1"></i> Bloqueado por saldo pendiente
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-success-subtle text-success border border-success-subtle small mt-1">
                                                        <i class="bi bi-check-circle-fill me-1"></i> Habilitado para compra
                                                    </span>
                                                }
                                            </td>
                                            <td class="text-center">
                                                @if (c.CustomerType == "Persona Natural")
                                                {
                                                    <span class="badge bg-info-subtle text-info-emphasis border border-info-subtle">
                                                        <i class="bi bi-person-fill me-1"></i> Persona Natural
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle">
                                                        <i class="bi bi-building me-1"></i> Empresa
                                                    </span>
                                                }
                                            </td>
                                            <td class="text-end font-monospace fw-bold @(hasDebt ? "text-danger" : "text-success")">
                                                $@c.CurrentBalance.ToString("N2")
                                            </td>
                                            <td class="text-center">
                                                @if (hasDebt)
                                                {
                                                    <button type="button" class="btn btn-outline-danger btn-sm"
                                                            title="Cliente no elegible: posee saldo pendiente de $@c.CurrentBalance.ToString("N2")"
                                                            @onclick="() => SelectCustomer(c)">
                                                        <i class="bi bi-slash-circle me-1"></i> Bloqueado
                                                    </button>
                                                }
                                                else
                                                {
                                                    <button type="button" class="btn btn-primary btn-sm" @onclick="() => SelectCustomer(c)">
                                                        <i class="bi bi-check-lg me-1"></i> Elegir
                                                    </button>
                                                }
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary" @onclick="ClosePickers">Cerrar</button>
                </div>
            </div>
        </div>
    </div>
}

<!-- Modal Selector de Productos -->
@if (ShowProductPicker)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content shadow border-0 rounded-3">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title fw-bold d-flex align-items-center gap-2">
                        <i class="bi bi-box-seam-fill"></i>
                        Seleccionar Producto para la Línea
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="ClosePickers"></button>
                </div>
                <div class="modal-body p-4">
                    @if (!string.IsNullOrEmpty(ProductPickerWarning))
                    {
                        <div class="alert alert-warning d-flex align-items-center gap-2 mb-3">
                            <i class="bi bi-exclamation-triangle-fill fs-5"></i>
                            <div>@ProductPickerWarning</div>
                        </div>
                    }

                    <div class="input-group mb-3 shadow-sm">
                        <span class="input-group-text bg-light text-secondary">
                            <i class="bi bi-funnel-fill me-1 text-primary"></i> Buscar por:
                        </span>
                        <select class="form-select flex-grow-0" style="width: 140px;"
                                value="@ProductPickerSearchType" @onchange="OnProductPickerSearchTypeChanged">
                            <option value="all">🔍 Todos</option>
                            <option value="name">📦 Nombre</option>
                            <option value="id">#️⃣ ID</option>
                        </select>
                        <input type="text" class="form-control" placeholder="@GetProductSearchPlaceholder()"
                               value="@ProductPickerSearchTerm" @oninput="OnProductPickerInput" />
                        @if (!string.IsNullOrEmpty(ProductPickerSearchTerm))
                        {
                            <button class="btn btn-outline-secondary" type="button" title="Limpiar búsqueda" @onclick="ClearProductPickerSearch">
                                <i class="bi bi-x-lg"></i>
                            </button>
                        }
                    </div>

                    <div class="table-responsive" style="max-height: 350px; overflow-y: auto;">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light sticky-top">
                                <tr>
                                    <th>ID</th>
                                    <th>Producto</th>
                                    <th class="text-end">Precio</th>
                                    <th class="text-center">Stock Disp.</th>
                                    <th class="text-center">Acción</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (AvailableProducts.Count == 0)
                                {
                                    <tr>
                                        <td colspan="5" class="text-center py-4 text-muted">
                                            No se encontraron productos disponibles en stock.
                                        </td>
                                    </tr>
                                }
                                else
                                {
                                    @foreach (var p in AvailableProducts)
                                    {
                                        var isAlreadyInOrder = IsProductAlreadySelected(p.Id);
                                        <tr class="@(isAlreadyInOrder ? "table-secondary bg-opacity-25" : "")">
                                            <td class="text-muted fw-bold">#@p.Id</td>
                                            <td>
                                                <div class="fw-semibold">@p.Name</div>
                                                @if (isAlreadyInOrder)
                                                {
                                                    <span class="badge bg-warning text-dark mt-1">
                                                        <i class="bi bi-check-circle-fill me-1"></i> Ya incluido en la orden
                                                    </span>
                                                }
                                            </td>
                                            <td class="text-end fw-bold text-primary">$@p.UnitPrice.ToString("N2")</td>
                                            <td class="text-center">
                                                <span class="badge bg-success-subtle text-success border border-success-subtle">
                                                    @p.UnitsInStock uds
                                                </span>
                                            </td>
                                            <td class="text-center">
                                                @if (isAlreadyInOrder)
                                                {
                                                    <button type="button" class="btn btn-outline-secondary btn-sm" disabled title="Este producto ya está incluido en la orden">
                                                        <i class="bi bi-lock-fill me-1"></i> Agregado
                                                    </button>
                                                }
                                                else
                                                {
                                                    <button type="button" class="btn btn-primary btn-sm" @onclick="() => SelectProduct(p)">
                                                        <i class="bi bi-plus-lg"></i> Agregar
                                                    </button>
                                                }
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary" @onclick="ClosePickers">Cerrar</button>
                </div>
            </div>
        </div>
    </div>
}

<!-- MODAL COMPROBANTE DE FACTURA (VOUCHER LEGAL AUDITABLE GENERADO) -->
@if (ShowInvoiceVoucherModal && CurrentInvoiceVoucher != null)
{
    var voucher = CurrentInvoiceVoucher;
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.65);">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content shadow border-0 rounded-4 overflow-hidden">
                <!-- Header Modal -->
                <div class="modal-header bg-dark text-white py-3 px-4 d-flex justify-content-between align-items-center">
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-receipt-cutoff text-warning fs-4"></i>
                        <h5 class="modal-title fw-bold mb-0 text-white" style="color: #ffffff !important;">Comprobante de Factura Generada</h5>
                    </div>
                    <button type="button" class="btn-close btn-close-white" @onclick="CloseInvoiceVoucher"></button>
                </div>

                <!-- Cuerpo de la Factura (Área imprimible) -->
                <div class="modal-body p-4 p-md-5 bg-white" id="invoiceVoucherArea">
                    <div class="border rounded-3 p-4 bg-white shadow-sm">
                        <!-- Cabecera de la Factura -->
                        <div class="row align-items-center mb-4 pb-3 border-bottom">
                            <div class="col-sm-7">
                                <div class="d-flex align-items-center gap-2 mb-1">
                                    <i class="bi bi-box-seam-fill text-primary fs-3"></i>
                                    <h3 class="h4 fw-bold text-dark mb-0">NorthWind Sales S.A.</h3>
                                </div>
                                <p class="text-muted small mb-0">Sistema de Punto de Venta & Facturación Electrónica</p>
                                <p class="text-muted small mb-0">RUC: 1790012345001 | Quito, Ecuador</p>
                            </div>
                            <div class="col-sm-5 text-sm-end mt-3 mt-sm-0">
                                <div class="badge bg-primary text-wrap p-2 fs-6 mb-1 font-monospace">
                                    @voucher.InvoiceNumber
                                </div>
                                <div class="small text-muted">
                                    <strong>Fecha:</strong> @voucher.CreatedDate.ToString("dd/MM/yyyy HH:mm:ss")
                                </div>
                                <div class="small text-muted">
                                    <strong>Vendedor:</strong> @voucher.SellerName
                                </div>
                            </div>
                        </div>

                        <!-- Datos del Cliente (Snapshot Inmutable) -->
                        <div class="row g-3 mb-4 p-3 bg-light rounded-3">
                            <div class="col-md-6">
                                <div class="text-muted small text-uppercase fw-bold">Adquirente / Cliente:</div>
                                <div class="fw-bold fs-6 text-dark">@voucher.CustomerFullName</div>
                                <div class="small text-muted">Cédula / RUC: <span class="font-monospace fw-bold text-dark">@voucher.CustomerDocument</span></div>
                                <div class="small text-muted">Código Interno: <span class="font-monospace">@voucher.CustomerId</span></div>
                            </div>
                            <div class="col-md-6 text-md-end">
                                @if (!string.IsNullOrEmpty(voucher.CustomerAddress))
                                {
                                    <div class="small text-muted"><strong>Dirección:</strong> @voucher.CustomerAddress</div>
                                }
                                @if (!string.IsNullOrEmpty(voucher.CustomerPhone))
                                {
                                    <div class="small text-muted"><strong>Teléfono:</strong> @voucher.CustomerPhone</div>
                                }
                                @if (!string.IsNullOrEmpty(voucher.CustomerEmail))
                                {
                                    <div class="small text-muted"><strong>Email:</strong> @voucher.CustomerEmail</div>
                                }
                            </div>
                        </div>

                        <!-- Detalle de Productos (Snapshot) -->
                        <div class="table-responsive mb-4">
                            <table class="table table-bordered align-middle mb-0">
                                <thead class="table-light small text-uppercase text-muted">
                                    <tr>
                                        <th style="width: 70px;" class="text-center">Cant.</th>
                                        <th>Descripción (Congelada)</th>
                                        <th style="width: 120px;" class="text-end">Precio Unit.</th>
                                        <th style="width: 130px;" class="text-end">Importe</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var d in voucher.Details)
                                    {
                                        <tr>
                                            <td class="text-center fw-bold font-monospace">@d.Quantity</td>
                                            <td class="fw-semibold">@d.ProductName</td>
                                            <td class="text-end font-monospace">$@d.UnitPrice.ToString("N2")</td>
                                            <td class="text-end font-monospace fw-bold text-dark">$@d.SubTotal.ToString("N2")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        <!-- Totales y Resumen -->
                        <div class="row justify-content-end mb-4">
                            <div class="col-md-6">
                                <div class="table-responsive">
                                    <table class="table table-sm table-borderless mb-0">
                                        <tbody>
                                            <tr>
                                                <td class="text-muted fw-semibold">Subtotal Neto:</td>
                                                <td class="text-end font-monospace fw-bold">$@voucher.SubTotal.ToString("N2")</td>
                                            </tr>
                                            <tr>
                                                <td class="text-muted fw-semibold">IVA Tarifa 15%:</td>
                                                <td class="text-end font-monospace fw-bold">$@voucher.Tax.ToString("N2")</td>
                                            </tr>
                                            <tr class="border-top">
                                                <td class="fs-5 fw-bold text-dark pt-2">TOTAL FACTURA:</td>
                                                <td class="fs-5 fw-bold font-monospace text-success text-end pt-2">
                                                    $@voucher.Total.ToString("N2")
                                                </td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>

                        <!-- Nota de Auditoría Legal -->
                        <div class="alert alert-secondary p-3 mb-0 small text-muted d-flex align-items-center gap-2">
                            <i class="bi bi-info-circle-fill text-primary fs-5"></i>
                            <div>
                                <strong>Registro de Integridad Histórica:</strong> Este comprobante fue generado automáticamente al registrar la orden y utiliza datos congelados en el momento de la venta.
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Footer Modal -->
                <div class="modal-footer bg-light py-3 px-4 d-flex justify-content-between">
                    <button type="button" class="btn btn-outline-secondary" @onclick="CloseInvoiceVoucher">
                        Cerrar
                    </button>
                    <button type="button" class="btn btn-primary d-flex align-items-center gap-2" @onclick="PrintInvoiceAsync">
                        <i class="bi bi-printer-fill"></i>
                        <span>Imprimir Comprobante</span>
                    </button>
                </div>
            </div>
        </div>
    </div>
}
