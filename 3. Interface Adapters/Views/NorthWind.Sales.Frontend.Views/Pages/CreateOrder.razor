@page "/createorder"
@attribute [Authorize]
@namespace NorthWind.Sales.Frontend.Views.Pages

<PageTitle>@CreateOrderMessages.CreateOrderPageTitle</PageTitle>

<ErrorBoundary @ref="ErrorBoundaryRef">
    <ChildContent>
        <CreateOrderComponent Order="ViewModel" />
    </ChildContent>
    <ErrorContent>
        <ExceptionDisplay Exception="context" />
        <button class="btn btn-danger mt-2" @onclick="Recover">
            @CommonMessages.OK
        </button>
    </ErrorContent>
</ErrorBoundary>
