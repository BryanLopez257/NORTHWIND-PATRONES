@page "/customers"
@attribute [Authorize]
@namespace NorthWind.Sales.Frontend.Views.Pages
@inject CustomersViewModel ViewModel
@inject NavigationManager NavigationManager
@implements IDisposable

<PageTitle>@CustomersMessages.PageTitle - NorthWind</PageTitle>

<div class="container-fluid px-0">
    <!-- Encabezado -->
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4 p-4 bg-white rounded-3 shadow-sm border">
        <div>
            <h1 class="h3 fw-bold text-dark mb-1 d-flex align-items-center gap-2">
                <i class="bi bi-people-fill text-primary"></i>
                @CustomersMessages.PageTitle
            </h1>
            <p class="text-muted mb-0 small">
                @CustomersMessages.Subtitle
            </p>
        </div>
        <div>
            <button class="btn btn-primary d-flex align-items-center gap-2 shadow-sm" @onclick="ViewModel.OpenCreateModal">
                <i class="bi bi-person-plus-fill"></i>
                <span>@CustomersMessages.NewCustomerButton</span>
            </button>
        </div>
    </div>

    <!-- Mensajes de Notificación -->
    @if (!string.IsNullOrEmpty(ViewModel.SuccessMessage))
    {
        <div class="alert alert-success alert-dismissible fade show d-flex align-items-center gap-2 shadow-sm mb-4" role="alert">
            <i class="bi bi-check-circle-fill fs-5"></i>
            <div>@ViewModel.SuccessMessage</div>
            <button type="button" class="btn-close ms-auto" @onclick="() => ViewModel.SuccessMessage = null"></button>
        </div>
    }

    @if (!string.IsNullOrEmpty(ViewModel.ErrorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center gap-2 shadow-sm mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill fs-5"></i>
            <div>@ViewModel.ErrorMessage</div>
            <button type="button" class="btn-close ms-auto" @onclick="() => ViewModel.ErrorMessage = null"></button>
        </div>
    }

    <!-- Segmentación Principal por Tipo de Cliente (Personas Naturales vs Empresas) -->
    <div class="mb-4">
        <div class="btn-group p-1 bg-white rounded-3 shadow-sm border w-100 w-md-auto d-flex" role="group">
            <button type="button" class="btn py-2 px-3 fw-semibold flex-fill d-flex align-items-center justify-content-center gap-2 @(string.IsNullOrEmpty(ViewModel.Filter.CustomerType) ? "btn-primary text-white shadow-sm" : "btn-light text-secondary")"
                    @onclick="() => SetCustomerTypeFilter(null)">
                <i class="bi bi-people-fill"></i>
                <span>Todos los Clientes</span>
            </button>
            <button type="button" class="btn py-2 px-3 fw-semibold flex-fill d-flex align-items-center justify-content-center gap-2 @(ViewModel.Filter.CustomerType == "Persona Natural" ? "btn-info text-white shadow-sm" : "btn-light text-secondary")"
                    @onclick='() => SetCustomerTypeFilter("Persona Natural")'>
                <i class="bi bi-person-badge-fill"></i>
                <span>Personas Naturales</span>
            </button>
            <button type="button" class="btn py-2 px-3 fw-semibold flex-fill d-flex align-items-center justify-content-center gap-2 @(ViewModel.Filter.CustomerType == "Empresa" ? "btn-dark text-white shadow-sm" : "btn-light text-secondary")"
                    @onclick='() => SetCustomerTypeFilter("Empresa")'>
                <i class="bi bi-building-fill"></i>
                <span>Empresas</span>
            </button>
        </div>
    </div>

    <!-- Buscador Segmentado Avanzado con Filtrado en Tiempo Real -->
    <div class="card border-0 shadow-sm mb-4 rounded-3">
        <div class="card-header bg-white py-3 border-bottom d-flex align-items-center justify-content-between flex-wrap gap-2">
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-funnel-fill text-primary"></i>
                <span class="fw-bold text-dark">Búsqueda Segmentada y Filtros de Clientes</span>
            </div>
            <span class="badge bg-light text-primary border">
                <i class="bi bi-lightning-charge-fill me-1 text-warning"></i> Filtrado en tiempo real activo
            </span>
        </div>
        <div class="card-body p-4 bg-light bg-opacity-50">
            <div class="row g-3">
                <!-- Búsqueda por término en tiempo real -->
                <div class="col-lg-3 col-md-6">
                    <label class="form-label fw-semibold small text-secondary">
                        <i class="bi bi-search me-1"></i> Búsqueda por Código o Nombre
                    </label>
                    <div class="input-group">
                        <span class="input-group-text bg-white"><i class="bi bi-search text-muted"></i></span>
                        <input type="text" class="form-control" placeholder="@CustomersMessages.SearchPlaceholder"
                               value="@ViewModel.Filter.SearchTerm" @oninput="OnSearchTermChanged" />
                        @if (!string.IsNullOrEmpty(ViewModel.Filter.SearchTerm))
                        {
                            <button class="btn btn-outline-secondary" type="button" title="Limpiar texto" @onclick="ClearSearchTerm">
                                <i class="bi bi-x-lg"></i>
                            </button>
                        }
                    </div>
                </div>

                <!-- Tipo de Cliente -->
                <div class="col-lg-3 col-md-6">
                    <label class="form-label fw-semibold small text-secondary">
                        <i class="bi bi-person-lines-fill me-1"></i> Tipo de Cliente
                    </label>
                    <select class="form-select" value="@ViewModel.Filter.CustomerType" @onchange="OnCustomerTypeSelectChanged">
                        <option value="">Todos los Tipos</option>
                        <option value="Persona Natural">👤 Persona Natural</option>
                        <option value="Empresa">🏢 Empresa</option>
                    </select>
                </div>

                <!-- Estado de Saldo (Segmentación) -->
                <div class="col-lg-2 col-md-6">
                    <label class="form-label fw-semibold small text-secondary">
                        <i class="bi bi-wallet2 me-1"></i> @CustomersMessages.BalanceFilterLabel
                    </label>
                    <select class="form-select" value="@ViewModel.Filter.BalanceFilter" @onchange="OnBalanceFilterSelectChanged">
                        <option value="">@CustomersMessages.AllBalances</option>
                        <option value="1">🟢 @CustomersMessages.PaidBalance</option>
                        <option value="2">🟡 @CustomersMessages.OutstandingBalance</option>
                        <option value="3">🔴 @CustomersMessages.HighBalance</option>
                    </select>
                </div>

                <!-- Rango de Saldo -->
                <div class="col-lg-2 col-md-6">
                    <label class="form-label fw-semibold small text-secondary">
                        <i class="bi bi-cash-stack me-1"></i> Rango Saldo
                    </label>
                    <div class="input-group">
                        <input type="number" step="10" min="0" class="form-control" placeholder="Mín"
                               value="@ViewModel.Filter.MinBalance" @oninput="OnMinBalanceInput" />
                        <span class="input-group-text bg-white small">-</span>
                        <input type="number" step="10" min="0" class="form-control" placeholder="Máx"
                               value="@ViewModel.Filter.MaxBalance" @oninput="OnMaxBalanceInput" />
                    </div>
                </div>

                <!-- Ordenar por -->
                <div class="col-lg-2 col-md-6">
                    <label class="form-label fw-semibold small text-secondary">
                        <i class="bi bi-sort-down me-1"></i> @CustomersMessages.OrderByLabel
                    </label>
                    <select class="form-select" value="@ViewModel.Filter.OrderBy" @onchange="OnOrderBySelectChanged">
                        <option value="name">Nombre</option>
                        <option value="id">Código ID</option>
                        <option value="balance">Saldo Actual</option>
                    </select>
                </div>
            </div>

            <!-- Chips Rápidos de Segmentación -->
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mt-3 pt-3 border-top">
                <div class="d-flex align-items-center gap-2 flex-wrap">
                    <span class="small text-muted fw-semibold">Segmentación de balances:</span>
                    <button type="button" class="btn btn-sm @(ViewModel.Filter.BalanceFilter == null ? "btn-secondary text-white" : "btn-outline-secondary")"
                            @onclick="() => SetBalanceFilter(null)">
                        Todos
                    </button>
                    <button type="button" class="btn btn-sm @(ViewModel.Filter.BalanceFilter == 1 ? "btn-success text-white" : "btn-outline-success")"
                            @onclick="() => SetBalanceFilter(1)">
                        Al Día ($0.00)
                    </button>
                    <button type="button" class="btn btn-sm @(ViewModel.Filter.BalanceFilter == 2 ? "btn-warning text-dark" : "btn-outline-warning")"
                            @onclick="() => SetBalanceFilter(2)">
                        Con Saldo Pendiente
                    </button>
                    <button type="button" class="btn btn-sm @(ViewModel.Filter.BalanceFilter == 3 ? "btn-danger text-white" : "btn-outline-danger")"
                            @onclick="() => SetBalanceFilter(3)">
                        Saldo Elevado (≥ $100)
                    </button>
                </div>

                <div class="d-flex align-items-center gap-2">
                    <button class="btn btn-outline-secondary d-flex align-items-center gap-1" @onclick="ResetAllFilters">
                        <i class="bi bi-arrow-counterclockwise"></i>
                        <span>@CommonMessages.Clear</span>
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Lista / Tabla de Clientes -->
    <div class="card border-0 shadow-sm rounded-3 overflow-hidden">
        <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center flex-wrap gap-2">
            <span class="fw-bold text-dark">
                Listado de Clientes
                <span class="badge bg-primary ms-2">@ViewModel.Customers.Count registros</span>
                @if (!string.IsNullOrEmpty(ViewModel.Filter.CustomerType))
                {
                    <span class="badge @(ViewModel.Filter.CustomerType == "Persona Natural" ? "bg-info text-dark" : "bg-dark text-white") ms-1">
                        @ViewModel.Filter.CustomerType
                    </span>
                }
            </span>
            @if (ViewModel.IsLoading)
            {
                <div class="spinner-border spinner-border-sm text-primary" role="status">
                    <span class="visually-hidden">Cargando...</span>
                </div>
            }
        </div>

        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th style="width: 120px;" class="text-center">@CustomersMessages.IdColumn</th>
                        <th>@CustomersMessages.NameColumn</th>
                        <th style="width: 170px;" class="text-center">Tipo de Cliente</th>
                        <th style="width: 160px;" class="text-end">@CustomersMessages.BalanceColumn</th>
                        <th style="width: 160px;" class="text-center">@CustomersMessages.StatusColumn</th>
                        <th style="width: 130px;" class="text-center">@CommonMessages.Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (ViewModel.Customers.Count == 0)
                    {
                        <tr>
                            <td colspan="6" class="text-center py-5 text-muted">
                                <i class="bi bi-people fs-1 d-block mb-2 text-secondary"></i>
                                @CustomersMessages.NoCustomersFound
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var c in ViewModel.Customers)
                        {
                            <tr>
                                <td class="text-center">
                                    <span class="badge bg-dark-subtle text-dark border px-2 py-1 font-monospace">@c.Id</span>
                                </td>
                                <td class="fw-semibold text-dark">@c.Name</td>
                                <td class="text-center">
                                    @if (c.CustomerType == "Persona Natural")
                                    {
                                        <span class="badge bg-info-subtle text-info-emphasis border border-info-subtle px-2 py-1">
                                            <i class="bi bi-person-fill me-1"></i> Persona Natural
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2 py-1">
                                            <i class="bi bi-building me-1"></i> Empresa
                                        </span>
                                    }
                                </td>
                                <td class="text-end fw-bold @(c.CurrentBalance > 0 ? "text-danger" : "text-success")">
                                    $@c.CurrentBalance.ToString("N2")
                                </td>
                                <td class="text-center">
                                    @if (c.CurrentBalance == 0)
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">
                                            <i class="bi bi-check-circle me-1"></i> Al Día
                                        </span>
                                    }
                                    else if (c.CurrentBalance >= 100)
                                    {
                                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-2 py-1">
                                            <i class="bi bi-exclamation-octagon me-1"></i> Saldo Alto
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle px-2 py-1">
                                            <i class="bi bi-clock-history me-1"></i> Con Saldo
                                        </span>
                                    }
                                </td>
                                <td class="text-center">
                                    <div class="btn-group btn-group-sm" role="group">
                                        <button class="btn btn-outline-primary" title="@CommonMessages.Edit" @onclick="() => ViewModel.OpenEditModal(c)">
                                            <i class="bi bi-pencil-square"></i>
                                        </button>
                                        <button class="btn btn-outline-danger" title="@CommonMessages.Delete" @onclick="() => ViewModel.OpenDeleteModal(c)">
                                            <i class="bi bi-trash3"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal para Crear / Editar Cliente -->
@if (ViewModel.IsFormModalOpen)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content shadow border-0 rounded-3">
                <div class="modal-header bg-light border-bottom">
                    <h5 class="modal-title fw-bold text-dark d-flex align-items-center gap-2">
                        <i class="bi @(ViewModel.CurrentCustomer.IsEditMode ? "bi-pencil-square text-primary" : "bi-person-plus-fill text-success")"></i>
                        @(ViewModel.CurrentCustomer.IsEditMode ? CustomersMessages.EditCustomerTitle : CustomersMessages.CreateCustomerTitle)
                    </h5>
                    <button type="button" class="btn-close" @onclick="ViewModel.CloseFormModal"></button>
                </div>
                <div class="modal-body p-4">
                    @if (!string.IsNullOrEmpty(ViewModel.ErrorMessage))
                    {
                        <div class="alert alert-danger d-flex align-items-center gap-2 mb-3 shadow-sm rounded-3">
                            <i class="bi bi-exclamation-triangle-fill fs-5"></i>
                            <div>@ViewModel.ErrorMessage</div>
                        </div>
                    }

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Tipo de Cliente <span class="text-danger">*</span></label>
                        <select class="form-select" @bind="ViewModel.CurrentCustomer.CustomerType">
                            <option value="Persona Natural">👤 Persona Natural (Cédula de Identidad)</option>
                            <option value="Empresa">🏢 Empresa (RUC)</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">
                            @CustomersMessages.IdColumn <span class="text-danger">*</span>
                            <small class="text-muted fw-normal">(5 caracteres en mayúsculas, ej: ALFKI - solo letras)</small>
                        </label>
                        <input type="text" class="form-control font-monospace" maxlength="5" placeholder="ALFKI"
                               data-alpha-only="true"
                               onkeypress="return /^[a-zA-Z]$/.test(event.key)"
                               @bind="ViewModel.CurrentCustomer.Id" disabled="@ViewModel.CurrentCustomer.IsEditMode" />
                        @if (ViewModel.CurrentCustomer.IsEditMode)
                        {
                            <small class="text-muted">El código identificador no se puede modificar.</small>
                        }
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">@CustomersMessages.NameColumn <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" maxlength="40" placeholder="Ej: Alfreds Futterkiste o Juan Pérez"
                               data-letters-only="true"
                               onkeypress="return /^[a-zA-ZáéíóúÁÉÍÓÚñÑüÜ\s]$/.test(event.key)"
                               @bind="ViewModel.CurrentCustomer.Name" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">@CustomersMessages.BalanceColumn <span class="text-danger">*</span></label>
                        <div class="input-group">
                            <span class="input-group-text">$</span>
                            <input type="number" step="0.5" min="0" class="form-control" placeholder="0.00"
                                   @bind="ViewModel.CurrentCustomer.CurrentBalance" />
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-light border-top">
                    <button type="button" class="btn btn-secondary" @onclick="ViewModel.CloseFormModal">
                        @CommonMessages.Cancel
                    </button>
                    <button type="button" class="btn btn-primary d-flex align-items-center gap-1" @onclick="ViewModel.SaveCustomer" disabled="@ViewModel.IsLoading">
                        <i class="bi bi-check2-circle"></i>
                        @CommonMessages.Save
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<!-- Modal de Confirmación de Eliminación -->
@if (ViewModel.IsDeleteModalOpen && ViewModel.CustomerToDelete != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content shadow border-0 rounded-3">
                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title fw-bold d-flex align-items-center gap-2">
                        <i class="bi bi-exclamation-triangle-fill"></i>
                        @CustomersMessages.DeleteCustomerTitle
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="ViewModel.CloseDeleteModal"></button>
                </div>
                <div class="modal-body p-4">
                    <p class="mb-0 text-dark">
                        @string.Format(CustomersMessages.DeleteConfirmationTemplate, ViewModel.CustomerToDelete.Name, ViewModel.CustomerToDelete.Id)
                    </p>
                </div>
                <div class="modal-footer bg-light border-top">
                    <button type="button" class="btn btn-secondary" @onclick="ViewModel.CloseDeleteModal">
                        @CommonMessages.Cancel
                    </button>
                    <button type="button" class="btn btn-danger d-flex align-items-center gap-1" @onclick="ViewModel.ConfirmDelete" disabled="@ViewModel.IsLoading">
                        <i class="bi bi-trash3-fill"></i>
                        @CommonMessages.Delete
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private CancellationTokenSource _searchCts;

    protected override void OnInitialized()
    {
        NavigationManager.NavigateTo("/createorder", replace: true);
    }

    protected override async Task OnInitializedAsync()
    {
        await ViewModel.InitializeAsync();
    }

    private async Task SetCustomerTypeFilter(string customerType)
    {
        await ViewModel.SetCustomerTypeFilter(customerType);
    }

    private async Task OnCustomerTypeSelectChanged(ChangeEventArgs e)
    {
        var val = e.Value?.ToString();
        await ViewModel.SetCustomerTypeFilter(val);
    }

    private async Task OnSearchTermChanged(ChangeEventArgs e)
    {
        ViewModel.Filter.SearchTerm = e.Value?.ToString() ?? "";
        await TriggerDebouncedSearch();
    }

    private async Task ClearSearchTerm()
    {
        ViewModel.Filter.SearchTerm = "";
        await ViewModel.ApplyFilters();
    }

    private async Task OnBalanceFilterSelectChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int val))
        {
            ViewModel.Filter.BalanceFilter = val;
        }
        else
        {
            ViewModel.Filter.BalanceFilter = null;
        }
        await ViewModel.ApplyFilters();
    }

    private async Task SetBalanceFilter(int? filter)
    {
        ViewModel.Filter.BalanceFilter = filter;
        await ViewModel.ApplyFilters();
    }

    private async Task OnMinBalanceInput(ChangeEventArgs e)
    {
        if (decimal.TryParse(e.Value?.ToString(), out decimal val))
        {
            ViewModel.Filter.MinBalance = val;
        }
        else
        {
            ViewModel.Filter.MinBalance = null;
        }
        await TriggerDebouncedSearch();
    }

    private async Task OnMaxBalanceInput(ChangeEventArgs e)
    {
        if (decimal.TryParse(e.Value?.ToString(), out decimal val))
        {
            ViewModel.Filter.MaxBalance = val;
        }
        else
        {
            ViewModel.Filter.MaxBalance = null;
        }
        await TriggerDebouncedSearch();
    }

    private async Task OnOrderBySelectChanged(ChangeEventArgs e)
    {
        ViewModel.Filter.OrderBy = e.Value?.ToString() ?? "name";
        await ViewModel.ApplyFilters();
    }

    private async Task ResetAllFilters()
    {
        await ViewModel.ResetFilters();
    }

    private async Task TriggerDebouncedSearch()
    {
        _searchCts?.Cancel();
        _searchCts = new CancellationTokenSource();
        var token = _searchCts.Token;

        try
        {
            await Task.Delay(200, token);
            if (!token.IsCancellationRequested)
            {
                await ViewModel.ApplyFilters();
            }
        }
        catch (TaskCanceledException)
        {
        }
    }

    public void Dispose()
    {
        _searchCts?.Cancel();
        _searchCts?.Dispose();
    }
}
