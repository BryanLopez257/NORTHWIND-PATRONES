@page "/products"
@attribute [Authorize]
@namespace NorthWind.Sales.Frontend.Views.Pages
@inject ProductsViewModel ViewModel
@inject NavigationManager NavigationManager
@implements IDisposable

<PageTitle>@ProductsMessages.PageTitle - NorthWind</PageTitle>

<div class="container-fluid px-0">
    <!-- Encabezado -->
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4 p-4 bg-white rounded-3 shadow-sm border">
        <div>
            <h1 class="h3 fw-bold text-dark mb-1 d-flex align-items-center gap-2">
                <i class="bi bi-box-seam text-primary"></i>
                @ProductsMessages.PageTitle
            </h1>
            <p class="text-muted mb-0 small">
                @ProductsMessages.Subtitle
            </p>
        </div>
        <div>
            <button class="btn btn-primary d-flex align-items-center gap-2 shadow-sm" @onclick="ViewModel.OpenCreateModal">
                <i class="bi bi-plus-lg"></i>
                <span>@ProductsMessages.NewProductButton</span>
            </button>
        </div>
    </div>

    <!-- Mensajes de Notificación -->
    @if (!string.IsNullOrEmpty(ViewModel.SuccessMessage))
    {
        <div class="alert alert-success alert-dismissible fade show d-flex align-items-center gap-2 shadow-sm mb-4" role="alert">
            <i class="bi bi-check-circle-fill fs-5"></i>
            <div>@ViewModel.SuccessMessage</div>
            <button type="button" class="btn-close ms-auto" @onclick="() => ViewModel.SuccessMessage = null"></button>
        </div>
    }

    @if (!string.IsNullOrEmpty(ViewModel.ErrorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center gap-2 shadow-sm mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill fs-5"></i>
            <div>@ViewModel.ErrorMessage</div>
            <button type="button" class="btn-close ms-auto" @onclick="() => ViewModel.ErrorMessage = null"></button>
        </div>
    }

    <!-- Buscador Segmentado Avanzado con Filtrado en Tiempo Real -->
    <div class="card border-0 shadow-sm mb-4 rounded-3">
        <div class="card-header bg-white py-3 border-bottom d-flex align-items-center justify-content-between flex-wrap gap-2">
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-funnel-fill text-primary"></i>
                <span class="fw-bold text-dark">Búsqueda Segmentada y Filtros de Productos</span>
            </div>
            <span class="badge bg-light text-primary border">
                <i class="bi bi-lightning-charge-fill me-1 text-warning"></i> Filtrado en tiempo real activo
            </span>
        </div>
        <div class="card-body p-4 bg-light bg-opacity-50">
            <div class="row g-3">
                <!-- Término de búsqueda en tiempo real -->
                <div class="col-lg-4 col-md-6">
                    <label class="form-label fw-semibold small text-secondary">
                        <i class="bi bi-search me-1"></i> Búsqueda por Nombre
                    </label>
                    <div class="input-group">
                        <span class="input-group-text bg-white"><i class="bi bi-search text-muted"></i></span>
                        <input type="text" class="form-control" placeholder="@ProductsMessages.SearchPlaceholder"
                               value="@ViewModel.Filter.SearchTerm" @oninput="OnSearchTermChanged" />
                        @if (!string.IsNullOrEmpty(ViewModel.Filter.SearchTerm))
                        {
                            <button class="btn btn-outline-secondary" type="button" title="Limpiar texto" @onclick="ClearSearchTerm">
                                <i class="bi bi-x-lg"></i>
                            </button>
                        }
                    </div>
                </div>

                <!-- Estado de Stock (Segmentación) -->
                <div class="col-lg-3 col-md-6">
                    <label class="form-label fw-semibold small text-secondary">
                        <i class="bi bi-boxes me-1"></i> @ProductsMessages.StockFilterLabel
                    </label>
                    <select class="form-select" value="@ViewModel.Filter.StockFilter" @onchange="OnStockFilterSelectChanged">
                        <option value="">@ProductsMessages.AllStock</option>
                        <option value="1">🟢 @ProductsMessages.InStock</option>
                        <option value="2">🟡 @ProductsMessages.LowStock</option>
                        <option value="3">🔴 @ProductsMessages.OutOfStock</option>
                    </select>
                </div>

                <!-- Rango de Precios -->
                <div class="col-lg-3 col-md-6">
                    <label class="form-label fw-semibold small text-secondary">
                        <i class="bi bi-currency-dollar me-1"></i> Rango de Precio
                    </label>
                    <div class="input-group">
                        <span class="input-group-text bg-white small">$</span>
                        <input type="number" step="0.5" min="0" class="form-control" placeholder="Mín"
                               value="@ViewModel.Filter.MinPrice" @oninput="OnMinPriceInput" />
                        <span class="input-group-text bg-white small">-</span>
                        <input type="number" step="0.5" min="0" class="form-control" placeholder="Máx"
                               value="@ViewModel.Filter.MaxPrice" @oninput="OnMaxPriceInput" />
                    </div>
                </div>

                <!-- Ordenar por -->
                <div class="col-lg-2 col-md-6">
                    <label class="form-label fw-semibold small text-secondary">
                        <i class="bi bi-sort-down me-1"></i> @ProductsMessages.OrderByLabel
                    </label>
                    <select class="form-select" value="@ViewModel.Filter.OrderBy" @onchange="OnOrderBySelectChanged">
                        <option value="name">Nombre</option>
                        <option value="price">Precio</option>
                        <option value="stock">Stock</option>
                    </select>
                </div>
            </div>

            <!-- Botones de Acción de Filtro y Chips Rápidos -->
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mt-3 pt-3 border-top">
                <div class="d-flex align-items-center gap-2 flex-wrap">
                    <span class="small text-muted fw-semibold">Segmentación de existencias:</span>
                    <button type="button" class="btn btn-sm @(ViewModel.Filter.StockFilter == null ? "btn-secondary text-white" : "btn-outline-secondary")"
                            @onclick="() => SetStockFilter(null)">
                        Todos
                    </button>
                    <button type="button" class="btn btn-sm @(ViewModel.Filter.StockFilter == 1 ? "btn-success text-white" : "btn-outline-success")"
                            @onclick="() => SetStockFilter(1)">
                        En Stock
                    </button>
                    <button type="button" class="btn btn-sm @(ViewModel.Filter.StockFilter == 2 ? "btn-warning text-dark" : "btn-outline-warning")"
                            @onclick="() => SetStockFilter(2)">
                        Stock Bajo (≤ 10)
                    </button>
                    <button type="button" class="btn btn-sm @(ViewModel.Filter.StockFilter == 3 ? "btn-danger text-white" : "btn-outline-danger")"
                            @onclick="() => SetStockFilter(3)">
                        Agotados
                    </button>
                </div>

                <div class="d-flex align-items-center gap-2">
                    <button class="btn btn-outline-secondary d-flex align-items-center gap-1" @onclick="ResetAllFilters">
                        <i class="bi bi-arrow-counterclockwise"></i>
                        <span>@CommonMessages.Clear</span>
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Lista / Tabla de Productos -->
    <div class="card border-0 shadow-sm rounded-3 overflow-hidden">
        <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
            <span class="fw-bold text-dark">
                Listado de Productos
                <span class="badge bg-primary ms-2">@ViewModel.Products.Count registros</span>
            </span>
            @if (ViewModel.IsLoading)
            {
                <div class="spinner-border spinner-border-sm text-primary" role="status">
                    <span class="visually-hidden">Cargando...</span>
                </div>
            }
        </div>

        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th style="width: 70px;" class="text-center">@ProductsMessages.IdColumn</th>
                        <th>@ProductsMessages.NameColumn</th>
                        <th style="width: 150px;" class="text-end">@ProductsMessages.PriceColumn</th>
                        <th style="width: 160px;" class="text-center">@ProductsMessages.StockColumn</th>
                        <th style="width: 140px;" class="text-center">@ProductsMessages.StatusColumn</th>
                        <th style="width: 140px;" class="text-center">@CommonMessages.Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (ViewModel.Products.Count == 0)
                    {
                        <tr>
                            <td colspan="6" class="text-center py-5 text-muted">
                                <i class="bi bi-inbox fs-1 d-block mb-2 text-secondary"></i>
                                @ProductsMessages.NoProductsFound
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var p in ViewModel.Products)
                        {
                            <tr>
                                <td class="text-center fw-bold text-secondary">#@p.Id</td>
                                <td class="fw-semibold text-dark">@p.Name</td>
                                <td class="text-end fw-bold text-primary">$@p.UnitPrice.ToString("N2")</td>
                                <td class="text-center">
                                    <span class="fw-semibold">@p.UnitsInStock</span> uds.
                                </td>
                                <td class="text-center">
                                    @if (p.UnitsInStock == 0)
                                    {
                                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-2 py-1">
                                            <i class="bi bi-x-circle me-1"></i> Agotado
                                        </span>
                                    }
                                    else if (p.UnitsInStock <= 10)
                                    {
                                        <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle px-2 py-1">
                                            <i class="bi bi-exclamation-circle me-1"></i> Stock Bajo
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">
                                            <i class="bi bi-check-circle me-1"></i> En Stock
                                        </span>
                                    }
                                </td>
                                <td class="text-center">
                                    <div class="btn-group btn-group-sm" role="group">
                                        <button class="btn btn-outline-primary" title="@CommonMessages.Edit" @onclick="() => ViewModel.OpenEditModal(p)">
                                            <i class="bi bi-pencil-square"></i>
                                        </button>
                                        <button class="btn btn-outline-danger" title="@CommonMessages.Delete" @onclick="() => ViewModel.OpenDeleteModal(p)">
                                            <i class="bi bi-trash3"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal para Crear / Editar Producto -->
@if (ViewModel.IsFormModalOpen)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content shadow border-0 rounded-3">
                <div class="modal-header bg-light border-bottom">
                    <h5 class="modal-title fw-bold text-dark d-flex align-items-center gap-2">
                        <i class="bi @(ViewModel.CurrentProduct.IsEditMode ? "bi-pencil-square text-primary" : "bi-plus-circle text-success")"></i>
                        @(ViewModel.CurrentProduct.IsEditMode ? ProductsMessages.EditProductTitle : ProductsMessages.CreateProductTitle)
                    </h5>
                    <button type="button" class="btn-close" @onclick="ViewModel.CloseFormModal"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">@ProductsMessages.NameColumn <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" maxlength="40" placeholder="Ej: Café Colombiano"
                               @bind="ViewModel.CurrentProduct.Name" />
                    </div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">@ProductsMessages.PriceColumn <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text">$</span>
                                <input type="number" step="0.5" min="0.01" class="form-control" placeholder="0.00"
                                       @bind="ViewModel.CurrentProduct.UnitPrice" />
                            </div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">@ProductsMessages.StockColumn <span class="text-danger">*</span></label>
                            <input type="number" min="0" class="form-control" placeholder="0"
                                   @bind="ViewModel.CurrentProduct.UnitsInStock" />
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-light border-top">
                    <button type="button" class="btn btn-secondary" @onclick="ViewModel.CloseFormModal">
                        @CommonMessages.Cancel
                    </button>
                    <button type="button" class="btn btn-primary d-flex align-items-center gap-1" @onclick="ViewModel.SaveProduct" disabled="@ViewModel.IsLoading">
                        <i class="bi bi-check2-circle"></i>
                        @CommonMessages.Save
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<!-- Modal de Confirmación de Eliminación -->
@if (ViewModel.IsDeleteModalOpen && ViewModel.ProductToDelete != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content shadow border-0 rounded-3">
                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title fw-bold d-flex align-items-center gap-2">
                        <i class="bi bi-exclamation-triangle-fill"></i>
                        @ProductsMessages.DeleteProductTitle
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="ViewModel.CloseDeleteModal"></button>
                </div>
                <div class="modal-body p-4">
                    <p class="mb-0 text-dark">
                        @string.Format(ProductsMessages.DeleteConfirmationTemplate, ViewModel.ProductToDelete.Name, ViewModel.ProductToDelete.Id)
                    </p>
                </div>
                <div class="modal-footer bg-light border-top">
                    <button type="button" class="btn btn-secondary" @onclick="ViewModel.CloseDeleteModal">
                        @CommonMessages.Cancel
                    </button>
                    <button type="button" class="btn btn-danger d-flex align-items-center gap-1" @onclick="ViewModel.ConfirmDelete" disabled="@ViewModel.IsLoading">
                        <i class="bi bi-trash3-fill"></i>
                        @CommonMessages.Delete
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private CancellationTokenSource _searchCts;

    protected override void OnInitialized()
    {
        NavigationManager.NavigateTo("/createorder", replace: true);
    }

    protected override async Task OnInitializedAsync()
    {
        await ViewModel.InitializeAsync();
    }

    private async Task OnSearchTermChanged(ChangeEventArgs e)
    {
        ViewModel.Filter.SearchTerm = e.Value?.ToString() ?? "";
        await TriggerDebouncedSearch();
    }

    private async Task ClearSearchTerm()
    {
        ViewModel.Filter.SearchTerm = "";
        await ViewModel.ApplyFilters();
    }

    private async Task OnStockFilterSelectChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int val))
        {
            ViewModel.Filter.StockFilter = val;
        }
        else
        {
            ViewModel.Filter.StockFilter = null;
        }
        await ViewModel.ApplyFilters();
    }

    private async Task SetStockFilter(int? filter)
    {
        ViewModel.Filter.StockFilter = filter;
        await ViewModel.ApplyFilters();
    }

    private async Task OnMinPriceInput(ChangeEventArgs e)
    {
        if (decimal.TryParse(e.Value?.ToString(), out decimal val))
        {
            ViewModel.Filter.MinPrice = val;
        }
        else
        {
            ViewModel.Filter.MinPrice = null;
        }
        await TriggerDebouncedSearch();
    }

    private async Task OnMaxPriceInput(ChangeEventArgs e)
    {
        if (decimal.TryParse(e.Value?.ToString(), out decimal val))
        {
            ViewModel.Filter.MaxPrice = val;
        }
        else
        {
            ViewModel.Filter.MaxPrice = null;
        }
        await TriggerDebouncedSearch();
    }

    private async Task OnOrderBySelectChanged(ChangeEventArgs e)
    {
        ViewModel.Filter.OrderBy = e.Value?.ToString() ?? "name";
        await ViewModel.ApplyFilters();
    }

    private async Task ResetAllFilters()
    {
        await ViewModel.ResetFilters();
    }

    private async Task TriggerDebouncedSearch()
    {
        _searchCts?.Cancel();
        _searchCts = new CancellationTokenSource();
        var token = _searchCts.Token;

        try
        {
            await Task.Delay(200, token);
            if (!token.IsCancellationRequested)
            {
                await ViewModel.ApplyFilters();
            }
        }
        catch (TaskCanceledException)
        {
        }
    }

    public void Dispose()
    {
        _searchCts?.Cancel();
        _searchCts?.Dispose();
    }
}
