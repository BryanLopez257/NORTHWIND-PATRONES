@page "/"
@namespace NorthWind.Sales.BlazorClient.Pages

<PageTitle>NorthWind Sales - Inicio</PageTitle>

<div class="hero-section">
    <div class="hero-badge">
        <i class="bi bi-stars"></i>
        <span>Clean Architecture .NET 10</span>
    </div>
    <h1 class="hero-title">Sistema de Gestión de Ventas NorthWind</h1>
    <p class="hero-subtitle">
        Plataforma empresarial construida con arquitectura limpia: emisión de órdenes de venta, facturación electrónica secuencial y notificaciones automáticas por Mailtrap.
    </p>

    <div class="d-flex flex-wrap gap-3">
        <AuthorizeView>
            <Authorized>
                <a href="createorder" class="btn btn-primary btn-lg px-4">
                    <i class="bi bi-cart-plus me-2"></i>
                    Crear Orden
                </a>
                <a href="invoices" class="btn btn-outline-light btn-lg px-4">
                    <i class="bi bi-receipt me-2"></i>
                    Historial Facturas
                </a>
            </Authorized>
            <NotAuthorized>
                <a href="user/login" class="btn btn-primary btn-lg px-4">
                    <i class="bi bi-box-arrow-in-right me-2"></i>
                    Iniciar Sesión
                </a>
                <a href="user/register" class="btn btn-outline-light btn-lg px-4">
                    <i class="bi bi-person-plus me-2"></i>
                    Crear Cuenta
                </a>
            </NotAuthorized>
        </AuthorizeView>
    </div>
</div>

<div class="row g-4 mb-5">
    <div class="col-md-4">
        <div class="feature-card">
            <div class="feature-icon-box" style="background-color: #f0fdf4; color: #16a34a;">
                <i class="bi bi-bag-check-fill"></i>
            </div>
            <h3 class="feature-title">Órdenes de Venta</h3>
            <p class="feature-desc">
                Registro de órdenes con liquidación de base imponible e IVA 15%, validación de saldo deudor y control de stock atómico.
            </p>
            <AuthorizeView>
                <Authorized>
                    <a href="createorder" class="fw-semibold text-primary mt-auto">
                        Ir al formulario <i class="bi bi-arrow-right"></i>
                    </a>
                </Authorized>
                <NotAuthorized>
                    <span class="text-muted small mt-auto">Requiere inicio de sesión</span>
                </NotAuthorized>
            </AuthorizeView>
        </div>
    </div>

    <div class="col-md-4">
        <div class="feature-card">
            <div class="feature-icon-box icon-box-purple">
                <i class="bi bi-receipt"></i>
            </div>
            <h3 class="feature-title">Facturación Inmutable</h3>
            <p class="feature-desc">
                Generación automática de facturas con el Patrón Instantánea (Snapshot): congelamiento de precios históricos y trazabilidad fiscal auditada.
            </p>
            <AuthorizeView>
                <Authorized>
                    <a href="invoices" class="fw-semibold text-primary mt-auto">
                        Ver facturas <i class="bi bi-arrow-right"></i>
                    </a>
                </Authorized>
                <NotAuthorized>
                    <span class="text-muted small mt-auto">Requiere inicio de sesión</span>
                </NotAuthorized>
            </AuthorizeView>
        </div>
    </div>

    <div class="col-md-4">
        <div class="feature-card">
            <div class="feature-icon-box icon-box-emerald">
                <i class="bi bi-envelope-at-fill"></i>
            </div>
            <h3 class="feature-title">Eventos & Mailtrap</h3>
            <p class="feature-desc">
                Disparo reactivo de eventos de dominio cuando una orden supera los 3 productos, notificando al administrador vía SMTP en Mailtrap.
            </p>
            <span class="badge bg-success-subtle text-success border border-success-subtle mt-auto">
                <i class="bi bi-check-circle me-1"></i> Conectado a Mailtrap
            </span>
        </div>
    </div>
</div>
