{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://0.0.0.0:5000"
      }
    }
  },
  "AllowedHosts": "*",
  "DBOptions": {
    "ConnectionString": "Server=localhost,1433;Database=NorthWindDB;User Id=sa;Password=YourPasswordHere!;TrustServerCertificate=True;",
    "DomainLogsConnectionString": "Server=localhost,1433;Database=NorthWindLogsDB;User Id=sa;Password=YourPasswordHere!;TrustServerCertificate=True;"
  },
  "MembershipDBOptions": {
    "ConnectionString": "Server=localhost,1433;Database=NorthWindUsersDB;User Id=sa;Password=YourPasswordHere!;TrustServerCertificate=True;"
  },
  "SmtpOptions": {
    "SmtpHost": "sandbox.smtp.mailtrap.io",
    "SmtpHostPort": 2525,
    "SmtpUserName": "your_mailtrap_user",
    "SmtpPassword": "your_mailtrap_password",
    "SenderEmail": "noreply@northwind.com",
    "AdministratorEmail": "admin@northwind.com"
  },
  "JwtOptions": {
    "SecurityKey": "Your32CharacterLongSecretSecurityKeyHere!!",
    "ValidIssuer": "NorthWindAuthServer",
    "ValidAudience": "NorthWindClient",
    "ExpireInMinutes": 60,
    "ValidateIssuer": true,
    "ValidateAudience": true,
    "ValidateLifetime": true,
    "ValidateIssuerSigningKey": true
  }
}
