@namespace NorthWind.Membership.Frontend.RazorViews.Components

<div class="auth-wrapper">
    <div class="auth-card">
        <div class="auth-header">
            <div class="auth-icon-badge">
                <i class="bi bi-person-fill-lock"></i>
            </div>
            <h2 class="auth-title">@UserLoginMessages.LoginButtonText</h2>
            <p class="auth-subtitle">Ingresa tus credenciales para acceder al sistema</p>
        </div>

        <div class="auth-body">
            @if (!string.IsNullOrWhiteSpace(ViewModel.ErrorMessage))
            {
                <div class="alert alert-danger d-flex align-items-center mb-4">
                    <i class="bi bi-exclamation-triangle-fill me-2 fs-5"></i>
                    <div>@ViewModel.ErrorMessage</div>
                </div>
            }

            <EditForm Model="ViewModel" OnValidSubmit="ViewModel.Login">
                <ModelValidator Validator="ViewModel.Validator" @ref="ViewModel.ModelValidatorComponentReference" />
                <ValidationSummary />

                <div class="mb-3">
                    <label for="Email">
                        <i class="bi bi-envelope text-primary"></i>
                        @CommonMessages.EmailLabel
                    </label>
                    <InputText id="Email" class="form-control" placeholder="ejemplo@northwind.com" @bind-Value="ViewModel.Email" />
                    <ValidationMessage For="@(() => ViewModel.Email)" />
                </div>

                <div class="mb-4">
                    <label for="Password">
                        <i class="bi bi-key text-primary"></i>
                        @CommonMessages.PasswordLabel
                    </label>
                    <InputText id="Password" class="form-control" placeholder="••••••••" type="password" @bind-Value="ViewModel.Password" />
                    <ValidationMessage For="@(() => ViewModel.Password)" />
                </div>

                <div class="d-grid">
                    <button type="submit" class="btn btn-primary py-2">
                        <i class="bi bi-box-arrow-in-right"></i>
                        @UserLoginMessages.LoginButtonText
                    </button>
                </div>
            </EditForm>
        </div>

        <div class="auth-footer">
            <span class="text-muted">¿No tienes una cuenta aún?</span>
            <a href="user/register" class="fw-semibold ms-1">@CommonMessages.CreateAccountText</a>
        </div>
    </div>
</div>
