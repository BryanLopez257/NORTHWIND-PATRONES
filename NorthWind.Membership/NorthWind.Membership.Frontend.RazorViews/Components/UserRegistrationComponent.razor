@namespace NorthWind.Membership.Frontend.RazorViews.Components

<div class="auth-wrapper">
    <div class="auth-card auth-card-wide">
        <div class="auth-header">
            <div class="auth-icon-badge">
                <i class="bi bi-person-plus-fill"></i>
            </div>
            <h2 class="auth-title">@UserRegistrationMessages.RegisterButtonText</h2>
            <p class="auth-subtitle">Crea tu cuenta para comenzar a operar en NorthWind</p>
        </div>

        <div class="auth-body">
            @if (!string.IsNullOrWhiteSpace(ViewModel.InformationMessage))
            {
                <div class="alert alert-success d-flex align-items-center mb-4">
                    <i class="bi bi-check-circle-fill me-2 fs-5"></i>
                    <div>@ViewModel.InformationMessage</div>
                </div>
            }

            @if (!string.IsNullOrWhiteSpace(ViewModel.ErrorMessage))
            {
                <div class="alert alert-danger d-flex align-items-center mb-4">
                    <i class="bi bi-exclamation-triangle-fill me-2 fs-5"></i>
                    <div>@ViewModel.ErrorMessage</div>
                </div>
            }

            <EditForm Model="ViewModel" OnValidSubmit="ViewModel.Register">
                <ModelValidator Validator="ViewModel.Validator" @ref="ViewModel.ModelValidatorComponentReference" />
                <ValidationSummary />

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label for="FirstName">
                            <i class="bi bi-person text-primary"></i>
                            @UserRegistrationMessages.FirstNameLabel
                        </label>
                        <InputText id="FirstName" class="form-control" placeholder="Ej. Juan" maxlength="50" autocomplete="given-name" data-letters-only @bind-Value="ViewModel.FirstName" />
                        <div class="form-text text-muted" style="font-size: 0.75rem;">Solo letras y espacios (2 a 50 caracteres). Sin emojis.</div>
                        <ValidationMessage For="@(() => ViewModel.FirstName)" />
                    </div>
                    <div class="col-md-6">
                        <label for="SecondName">
                            <i class="bi bi-person text-primary"></i>
                            @UserRegistrationMessages.SecondNameLabel
                        </label>
                        <InputText id="SecondName" class="form-control" placeholder="Ej. Carlos" maxlength="50" autocomplete="additional-name" data-letters-only @bind-Value="ViewModel.SecondName" />
                        <div class="form-text text-muted" style="font-size: 0.75rem;">Opcional. 2 a 50 caracteres. Sin emojis.</div>
                        <ValidationMessage For="@(() => ViewModel.SecondName)" />
                    </div>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label for="LastName">
                            <i class="bi bi-person text-primary"></i>
                            @UserRegistrationMessages.LastNameLabel
                        </label>
                        <InputText id="LastName" class="form-control" placeholder="Ej. Pérez" maxlength="50" autocomplete="family-name" data-letters-only @bind-Value="ViewModel.LastName" />
                        <div class="form-text text-muted" style="font-size: 0.75rem;">Solo letras y espacios (2 a 50 caracteres). Sin emojis.</div>
                        <ValidationMessage For="@(() => ViewModel.LastName)" />
                    </div>
                    <div class="col-md-6">
                        <label for="SecondLastName">
                            <i class="bi bi-person text-primary"></i>
                            @UserRegistrationMessages.SecondLastNameLabel
                        </label>
                        <InputText id="SecondLastName" class="form-control" placeholder="Ej. Gómez" maxlength="50" autocomplete="family-name" data-letters-only @bind-Value="ViewModel.SecondLastName" />
                        <div class="form-text text-muted" style="font-size: 0.75rem;">Opcional. 2 a 50 caracteres. Sin emojis.</div>
                        <ValidationMessage For="@(() => ViewModel.SecondLastName)" />
                    </div>
                </div>

                <div class="mb-3">
                    <label for="Email">
                        <i class="bi bi-envelope text-primary"></i>
                        @CommonMessages.EmailLabel
                    </label>
                    <InputText id="Email" class="form-control" placeholder="ejemplo@northwind.com" maxlength="100" autocomplete="email" @bind-Value="ViewModel.Email" />
                    <div class="form-text text-muted" style="font-size: 0.75rem;">Solo letras, números, punto (.) y arroba (@@). Máx. 100 caracteres.</div>
                    <ValidationMessage For="@(() => ViewModel.Email)" />
                </div>

                <div class="row g-3 mb-4">
                    <div class="col-md-6">
                        <label for="Password">
                            <i class="bi bi-key text-primary"></i>
                            @CommonMessages.PasswordLabel
                        </label>
                        <InputText id="Password" class="form-control" placeholder="Mínimo 6 caracteres" maxlength="100" autocomplete="new-password" type="password" @bind-Value="ViewModel.Password" />
                        <div class="form-text text-muted" style="font-size: 0.75rem;">Mín. 6, mayúscula, dígito y símbolo. Sin emojis.</div>
                        <ValidationMessage For="@(() => ViewModel.Password)" />
                    </div>
                    <div class="col-md-6">
                        <label for="PasswordConfirmation">
                            <i class="bi bi-shield-check text-primary"></i>
                            @UserRegistrationMessages.PasswordConfirmationLabel
                        </label>
                        <InputText id="PasswordConfirmation" class="form-control" placeholder="Repite la contraseña" maxlength="100" autocomplete="new-password" type="password" @bind-Value="ViewModel.PasswordConfirmation" />
                        <ValidationMessage For="@(() => ViewModel.PasswordConfirmation)" />
                    </div>
                </div>

                <div class="d-grid">
                    <button type="submit" class="btn btn-primary py-2">
                        <i class="bi bi-check2-circle"></i>
                        @UserRegistrationMessages.RegisterButtonText
                    </button>
                </div>
            </EditForm>
        </div>

        <div class="auth-footer">
            <span class="text-muted">¿Ya tienes una cuenta registrada?</span>
            <a href="user/login" class="fw-semibold ms-1">@CommonMessages.LoginText</a>
        </div>
    </div>
</div>
