@namespace NorthWind.Membership.Frontend.RazorViews.Pages
@page "/user/logout"

<div class="auth-wrapper">
    <div class="auth-card text-center p-4">
        <div class="auth-icon-badge" style="background: linear-gradient(135deg, #ef4444 0%, #b91c1c 100%); box-shadow: 0 8px 16px -4px rgba(239, 68, 68, 0.35);">
            <i class="bi bi-box-arrow-right"></i>
        </div>
        <h3 class="auth-title mb-2">@CommonMessages.CloseSessionText</h3>
        <p class="auth-subtitle mb-4">¿Estás seguro de que deseas salir del sistema?</p>
        
        <div class="d-flex justify-content-center gap-3">
            <a href="" class="btn btn-secondary px-4">
                <i class="bi bi-arrow-left"></i>
                Volver
            </a>
            <button class="btn btn-danger px-4" @onclick="@(async () => await CloseSession())">
                <i class="bi bi-check2"></i>
                Confirmar Salida
            </button>
        </div>
    </div>
</div>
