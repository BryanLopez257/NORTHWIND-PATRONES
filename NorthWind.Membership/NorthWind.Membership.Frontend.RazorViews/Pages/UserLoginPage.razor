@namespace NorthWind.Membership.Frontend.RazorViews.Pages
@page "/user/login"

<ErrorBoundary @ref="ErrorBoundaryRef">
    <ChildContent>
        <UserLoginComponent ViewModel="ViewModel" />
    </ChildContent>
    <ErrorContent>
        <ExceptionDisplay Exception="context" />
        <button class="btn btn-danger" @onclick="Recover">@CommonMessages.OK</button>
    </ErrorContent>
</ErrorBoundary>
